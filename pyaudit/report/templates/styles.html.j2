<style>
  :root {
    --bg: #0a0c10;
    --panel: #12151c;
    --panel-2: #171b24;
    --border: #242835;
    --border-soft: #1b1f29;
    --text: #eef0f4;
    --muted: #8b93a3;
    --muted-2: #5f6779;
    --green: #3fb950;
    --green-bg: rgba(63, 185, 80, .13);
    --amber: #e3a008;
    --amber-bg: rgba(227, 160, 8, .13);
    --red: #f85149;
    --red-bg: rgba(248, 81, 73, .13);
    --blue: #5b9df9;
    --violet: #9d7bf0;
    --teal: #35c2c1;
    --orange: #f0924a;
    --slate: #7c8798;
    --radius: 14px;
    --radius-sm: 9px;
    --shadow: 0 1px 2px rgba(0,0,0,.4), 0 8px 24px -10px rgba(0,0,0,.55);
    --bg-glow: #182036;
    --nav-overlay: rgba(10, 12, 16, .82);
  }
  :root[data-theme="light"] {
    --bg: #f5f6f8;
    --panel: #ffffff;
    --panel-2: #f0f1f4;
    --border: #e2e4ea;
    --border-soft: #eaecf0;
    --text: #14161b;
    --muted: #5b6472;
    --muted-2: #5f6b7a;
    --green: #1a7f37;
    --green-bg: rgba(26, 127, 55, .10);
    --amber: #9a6700;
    --amber-bg: rgba(154, 103, 0, .10);
    --red: #cf222e;
    --red-bg: rgba(207, 34, 46, .10);
    --blue: #2f6fed;
    --violet: #7c5cf0;
    --teal: #0e9a99;
    --orange: #d97528;
    --slate: #667085;
    --shadow: 0 1px 2px rgba(0,0,0,.06), 0 8px 20px -12px rgba(0,0,0,.12);
    --bg-glow: #e4ebfb;
    --nav-overlay: rgba(255, 255, 255, .82);
  }
  * { box-sizing: border-box; }
  html, body { padding: 0; }
  body {
    margin: 0;
    background: var(--bg) radial-gradient(circle at 12% -10%, var(--bg-glow) 0%, transparent 45%);
    background-attachment: fixed;
    color: var(--text);
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .shell { max-width: 1080px; margin: 0 auto; padding: 8px 28px 64px; }

  a { color: var(--blue); }

  /* ---- title block ---- */
  .title-block { padding: 22px 0 6px; }
  .brand { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; }
  .brand-mark {
    width: 26px; height: 26px; border-radius: 7px; flex: none;
    background: linear-gradient(135deg, var(--blue), var(--violet));
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 800; color: #fff; letter-spacing: -.02em;
  }
  .brand-name { font-size: 13px; font-weight: 700; letter-spacing: .02em; color: var(--muted); text-transform: uppercase; }
  .title-block h1 { font-size: 25px; margin: 0 0 4px; letter-spacing: -.01em; }
  .title-block .meta { color: var(--muted); margin: 0; font-size: 13.5px; }

  /* ---- hero / score ---- */
  .hero {
    display: flex; gap: 32px; align-items: center; flex-wrap: wrap;
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 26px 28px; margin: 20px 0 20px;
  }
  .gauge { position: relative; width: 150px; height: 150px; flex: none; }
  .gauge svg { transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: var(--border); stroke-width: 12; }
  .ring-fg { fill: none; stroke-width: 12; stroke-linecap: round; transition: stroke-dashoffset .3s; }
  .ring-label {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    flex-direction: column;
  }
  .ring-label .num { font-size: 34px; font-weight: 800; letter-spacing: -.02em; }
  .ring-label .denom { font-size: 11px; color: var(--muted); margin-top: -2px; }
  .grade-badge {
    position: absolute; right: -4px; bottom: 2px; width: 34px; height: 34px; border-radius: 50%;
    border: 2px solid var(--panel); display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 800;
  }
  .hero-summary { flex: 1; min-width: 260px; }
  .hero-summary ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .hero-summary li { display: flex; gap: 9px; font-size: 14.5px; line-height: 1.5; color: var(--text); }
  .hero-summary li::before { content: "›"; color: var(--blue); font-weight: 800; }

  /* ---- stat cards ---- */
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 12px; margin-bottom: 26px; }
  .stat-card {
    background: var(--panel); border: 1px solid var(--border); border-top: 3px solid var(--accent, var(--blue));
    border-radius: var(--radius-sm); padding: 15px 16px; box-shadow: var(--shadow);
  }
  .stat-card .icon { width: 18px; height: 18px; color: var(--accent, var(--blue)); margin-bottom: 8px; }
  .stat-card .icon svg { width: 100%; height: 100%; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .stat-card .label { color: var(--muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; }
  .stat-card .value { font-size: 21px; font-weight: 800; margin-top: 5px; letter-spacing: -.01em; }
  .stat-card .sub { font-size: 12px; color: var(--muted-2); margin-top: 3px; }

  /* ---- section nav ---- */
  .section-nav {
    position: sticky; top: 0; z-index: 5; display: flex; gap: 4px; overflow-x: auto;
    background: var(--nav-overlay); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    padding: 10px 4px; margin: 0 0 22px; border-bottom: 1px solid var(--border-soft);
  }
  .section-nav a {
    display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px;
    font-size: 13px; color: var(--muted); text-decoration: none; white-space: nowrap;
  }
  .section-nav a:hover { background: var(--panel-2); color: var(--text); }
  .section-nav a .count { background: var(--panel-2); padding: 0 7px; border-radius: 999px; font-size: 11px; color: var(--text); }

  /* ---- panels / sections ---- */
  .panel {
    background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 20px 22px; margin-bottom: 18px; scroll-margin-top: 56px;
  }
  .panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .panel-head h2 {
    font-size: 13.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--text);
    display: flex; align-items: center; gap: 9px; margin: 0; font-weight: 700;
  }
  .panel-head h2 .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent, var(--blue)); flex: none; }
  .panel-head .badge-count { background: var(--panel-2); padding: 3px 11px; border-radius: 999px; font-size: 12px; color: var(--muted); }

  /* ---- tables ---- */
  .table-wrap { overflow-x: auto; border-radius: var(--radius-sm); border: 1px solid var(--border-soft); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead th {
    background: var(--panel-2); color: var(--muted); text-align: left; padding: 9px 12px;
    font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .04em;
  }
  tbody td { padding: 9px 12px; border-top: 1px solid var(--border-soft); }
  tbody tr:nth-child(even) { background: rgba(255,255,255,.012); }
  tbody tr:hover { background: rgba(255,255,255,.03); }
  code { background: var(--panel-2); border-radius: 4px; padding: 1px 6px; font-size: 12px; color: var(--text); }

  .pill {
    display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px 2px 8px; border-radius: 999px;
    font-size: 10.5px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap;
  }
  .pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
  .pill.high, .pill.error { background: var(--red-bg); color: var(--red); }
  .pill.medium, .pill.warning { background: var(--amber-bg); color: var(--amber); }
  .pill.low, .pill.convention, .pill.refactor { background: var(--green-bg); color: var(--green); }

  /* ---- score tones: always resolved from theme-aware vars, never a raw hex,
     so red/amber/green stay legible against the panel in both themes ---- */
  .tone-good { color: var(--green); }
  .tone-warn { color: var(--amber); }
  .tone-bad  { color: var(--red); }
  .tone-fill-good { background: var(--green); }
  .tone-fill-warn { background: var(--amber); }
  .tone-fill-bad  { background: var(--red); }
  .tone-chip-good { color: var(--green); background: var(--green-bg); }
  .tone-chip-warn { color: var(--amber); background: var(--amber-bg); }
  .tone-chip-bad  { color: var(--red);  background: var(--red-bg); }

  .bar-track { background: var(--border); border-radius: 999px; height: 7px; width: 100%; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 999px; }
  .cov-row { display: grid; grid-template-columns: 1fr 160px 48px; gap: 12px; align-items: center; padding: 6px 0; font-size: 13px; }
  .cov-row code { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }

  .empty-state {
    display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 30px 10px;
    color: var(--muted); border: 1px dashed var(--border); border-radius: var(--radius-sm); font-size: 13px;
  }
  .empty-state .icon { width: 22px; height: 22px; color: var(--green); }
  .empty-state .icon svg { width: 100%; height: 100%; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .more-note { color: var(--muted); font-size: 12.5px; margin: 10px 2px 0; }

  /* ---- collapse long tables/lists to a handful of rows by default ---- */
  tbody tr.row-extra, .cov-row.row-extra { display: none; }
  .show-more-btn {
    display: block; width: 100%; margin-top: 10px; padding: 8px 16px; border-radius: var(--radius-sm);
    border: 1px dashed var(--border); background: var(--panel-2); color: var(--muted);
    font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: inherit; text-align: center;
  }
  .show-more-btn:hover { border-color: var(--blue); color: var(--blue); border-style: solid; }

  .report-footer { color: var(--muted-2); font-size: 12px; margin-top: 8px; text-align: center; padding-top: 20px; border-top: 1px solid var(--border-soft); }

  /* ---- theme toggle ---- */
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px;
    border-radius: 999px; border: 1px solid var(--border); background: var(--panel-2); color: var(--text);
    cursor: pointer; flex: none;
  }
  .theme-toggle:hover { border-color: var(--blue); }
  .theme-toggle svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle .icon-moon { display: none; }
  :root[data-theme="light"] .theme-toggle .icon-sun { display: none; }
  :root[data-theme="light"] .theme-toggle .icon-moon { display: inline-flex; }

  /* ---- table toolbar (filter/sort) ---- */
  .table-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px; }
  .table-filter {
    flex: 1; max-width: 260px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 7px 10px; color: var(--text); font-size: 12.5px; font-family: inherit;
  }
  .table-filter:focus { outline: none; border-color: var(--blue); }
  .table-count { color: var(--muted-2); font-size: 11.5px; white-space: nowrap; }
  thead th.sortable { cursor: pointer; user-select: none; }
  thead th.sortable:hover { color: var(--text); }
  thead th.sort-active { color: var(--text); }
  thead th.sortable::after { content: "\21C5"; opacity: .35; margin-left: 5px; font-size: 10px; }
  thead th.sort-active[data-order="asc"]::after { content: "\25B2"; opacity: .9; }
  thead th.sort-active[data-order="desc"]::after { content: "\25BC"; opacity: .9; }

  /* ---- scan progress ---- */
  .stage-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .stage-list li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--muted); }
  .stage-list li .stage-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--border); flex: none; transition: background .2s, box-shadow .2s; }
  .stage-list li.active { color: var(--text); }
  .stage-list li.active .stage-dot { background: var(--blue); box-shadow: 0 0 0 3px rgba(91, 157, 249, .18); animation: pulse 1.1s ease-in-out infinite; }
  .stage-list li.complete { color: var(--text); }
  .stage-list li.complete .stage-dot { background: var(--green); }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }

  @media (max-width: 640px) {
    .shell { padding: 0 16px 48px; }
    .hero { padding: 20px; gap: 22px; }
    .cov-row { grid-template-columns: 1fr 100px 40px; }
  }
</style>
