<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>PyAudit report — {{ project_name }}</title>
<style>
  :root {
    --bg: #0f1115;
    --panel: #171a21;
    --border: #2a2e37;
    --text: #e6e8ec;
    --muted: #9aa1ac;
    --green: #3fb950;
    --amber: #d29922;
    --red: #f85149;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    padding: 32px;
  }
  .wrap { max-width: 980px; margin: 0 auto; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .subtitle { color: var(--muted); margin: 0 0 28px; font-size: 14px; }

  .score-row { display: flex; gap: 28px; align-items: center; margin-bottom: 28px; }
  .ring { position: relative; width: 128px; height: 128px; flex: none; }
  .ring svg { transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: var(--border); stroke-width: 10; }
  .ring-fg { fill: none; stroke-width: 10; stroke-linecap: round; }
  .ring-label {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    flex-direction: column;
  }
  .ring-label .num { font-size: 30px; font-weight: 700; }
  .ring-label .denom { font-size: 11px; color: var(--muted); }

  .summary { list-style: none; margin: 0; padding: 0; }
  .summary li { margin-bottom: 6px; font-size: 14px; color: var(--text); }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 32px; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 14px; }
  .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .card .value { font-size: 22px; font-weight: 700; margin-top: 4px; }

  section { margin-bottom: 32px; }
  h2 { font-size: 15px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-bottom: 10px; }

  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 500; }
  tr:last-child td { border-bottom: none; }
  code { background: var(--panel); border-radius: 4px; padding: 1px 5px; font-size: 12px; }

  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .pill.high, .pill.error { background: rgba(248,81,73,.15); color: var(--red); }
  .pill.medium, .pill.warning { background: rgba(210,153,34,.15); color: var(--amber); }
  .pill.low, .pill.convention, .pill.refactor { background: rgba(63,185,80,.15); color: var(--green); }

  .bar-track { background: var(--border); border-radius: 4px; height: 6px; width: 100%; overflow: hidden; }
  .bar-fill { height: 100%; }
  .cov-row { display: grid; grid-template-columns: 1fr 160px 48px; gap: 12px; align-items: center; padding: 5px 0; font-size: 13px; }

  .empty { color: var(--muted); font-size: 13px; font-style: italic; }
  footer { color: var(--muted); font-size: 12px; margin-top: 40px; }
</style>
</head>
<body>
<div class="wrap">

  <h1>PyAudit report</h1>
  <p class="subtitle">{{ project_name }}</p>

  <div class="score-row">
    <div class="ring">
      <svg width="128" height="128" viewBox="0 0 128 128">
        <circle class="ring-bg" cx="64" cy="64" r="54"></circle>
        {% set circumference = 339.29 %}
        {% set offset = circumference - (circumference * score / 100) %}
        {% set ring_color = '#3fb950' if score > 80 else ('#d29922' if score >= 60 else '#f85149') %}
        <circle class="ring-fg" cx="64" cy="64" r="54" stroke="{{ ring_color }}"
                stroke-dasharray="{{ circumference }}" stroke-dashoffset="{{ offset }}"></circle>
      </svg>
      <div class="ring-label">
        <span class="num">{{ score }}</span>
        <span class="denom">/ 100</span>
      </div>
    </div>
    <ul class="summary">
      {% for line in summary %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </div>

  <div class="cards">
    <div class="card">
      <div class="label">Complexity</div>
      <div class="value">{{ results.complexity.high_count }} high</div>
    </div>
    <div class="card">
      <div class="label">Static analysis</div>
      <div class="value">{{ results.static.error_count }} errors</div>
    </div>
    <div class="card">
      <div class="label">Dead code</div>
      <div class="value">{{ (results.deadcode.dead_ratio * 100) | round(1) }}%</div>
    </div>
    <div class="card">
      <div class="label">Security</div>
      <div class="value">{{ results.security.high_count }} high</div>
    </div>
    <div class="card">
      <div class="label">Dependencies</div>
      <div class="value">{{ results.dependencies.vulnerable_count }} vuln.</div>
    </div>
    <div class="card">
      <div class="label">Coverage</div>
      <div class="value">{% if results.coverage.available %}{{ results.coverage.overall_pct }}%{% else %}n/a{% endif %}</div>
    </div>
  </div>

  <section>
    <h2>Complexity — {{ results.complexity.high_count }} high, {{ results.complexity.medium_count }} medium</h2>
    {% if complexity_flagged %}
    <table>
      <tr><th>Risk</th><th>Complexity</th><th>Function</th><th>Location</th></tr>
      {% for f in complexity_flagged %}
      <tr>
        <td><span class="pill {{ f.risk.value }}">{{ f.risk.value }}</span></td>
        <td>{{ f.complexity }}</td>
        <td>{{ f.name }}</td>
        <td><code>{{ f.file }}:{{ f.lineno }}</code></td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p class="empty">No high or medium complexity functions found.</p>
    {% endif %}
  </section>

  <section>
    <h2>Static analysis — {{ results.static.error_count }} errors, {{ results.static.warning_count }} warnings</h2>
    {% if static_issues %}
    <table>
      <tr><th>Type</th><th>Message</th><th>Location</th></tr>
      {% for i in static_issues[:100] %}
      <tr>
        <td><span class="pill {{ i.category }}">{{ i.category }}</span></td>
        <td>{{ i.message }} <code>{{ i.symbol }}</code></td>
        <td><code>{{ i.file }}:{{ i.line }}</code></td>
      </tr>
      {% endfor %}
    </table>
    {% if static_issues | length > 100 %}<p class="empty">…and {{ static_issues | length - 100 }} more.</p>{% endif %}
    {% else %}
    <p class="empty">No errors or warnings found.</p>
    {% endif %}
  </section>

  <section>
    <h2>Dead code — {{ results.deadcode.items | length }} unused items</h2>
    {% if results.deadcode.items %}
    <table>
      <tr><th>Type</th><th>Name</th><th>Confidence</th><th>Location</th></tr>
      {% for d in results.deadcode.items %}
      <tr>
        <td>{{ d.type }}</td>
        <td>{{ d.name }}</td>
        <td>{{ d.confidence }}%</td>
        <td><code>{{ d.file }}:{{ d.lineno }}</code></td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p class="empty">No unused code found.</p>
    {% endif %}
  </section>

  <section>
    <h2>Security — {{ results.security.high_count }} high, {{ results.security.medium_count }} medium, {{ results.security.low_count }} low</h2>
    {% if security_issues %}
    <table>
      <tr><th>Severity</th><th>Issue</th><th>Test</th><th>Location</th></tr>
      {% for s in security_issues %}
      <tr>
        <td><span class="pill {{ s.severity }}">{{ s.severity }}</span></td>
        <td>{{ s.issue }}</td>
        <td><code>{{ s.test_id }}</code></td>
        <td><code>{{ s.file }}:{{ s.line }}</code></td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p class="empty">No security findings.</p>
    {% endif %}
  </section>

  <section>
    <h2>Dependencies{% if results.dependencies.source_file %} — {{ results.dependencies.source_file }}{% endif %}</h2>
    {% if not results.dependencies.scanned %}
    <p class="empty">No requirements.txt found — dependency scan skipped.</p>
    {% elif results.dependencies.vulnerable %}
    <table>
      <tr><th>Package</th><th>Installed</th><th>CVE / advisory</th><th>Fix version(s)</th></tr>
      {% for v in results.dependencies.vulnerable %}
      <tr>
        <td><span class="pill high">{{ v.name }}</span></td>
        <td>{{ v.installed_version }}</td>
        <td><code>{{ v.vulnerability_id }}</code></td>
        <td>{{ v.fix_versions | join(', ') if v.fix_versions else '—' }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p class="empty">No known vulnerabilities in scanned dependencies.</p>
    {% endif %}
  </section>

  <section>
    <h2>Coverage{% if results.coverage.available %} — {{ results.coverage.overall_pct }}% overall{% endif %}</h2>
    {% if results.coverage.available %}
      {% for f in coverage_files %}
      {% set bar_color = '#3fb950' if f.percent_covered >= coverage_target else ('#d29922' if f.percent_covered >= 40 else '#f85149') %}
      <div class="cov-row">
        <code>{{ f.file }}</code>
        <div class="bar-track"><div class="bar-fill" style="width: {{ f.percent_covered }}%; background: {{ bar_color }};"></div></div>
        <span>{{ f.percent_covered }}%</span>
      </div>
      {% endfor %}
    {% else %}
    <p class="empty">Coverage unavailable ({{ results.coverage.reason or 'unknown reason' }}).</p>
    {% endif %}
  </section>

  <footer>Generated by PyAudit.</footer>
</div>
</body>
</html>
